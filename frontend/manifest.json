{
  "manifest_version": 3,
  "name": "FactScope",
  "version": "1.2.0",
  "description": "AI-powered misinformation detection. Scan any page or image for trust signals, fact-checks, and community verification.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://factscope-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FactScope",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
